# Copy this file to .env and fill in your values.
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT=30

# Analysis queue and durable execution reservations
REDIS_URL=redis://127.0.0.1:6379/0
EXECUTION_TARGETS_FILE=execution-targets.json
COLLECTION_FRESHNESS_SECONDS=120
JOB_RETENTION_SECONDS=604800
# Set false to use deterministic fallback without sending data to an LLM.
LLM_EXTERNAL_ENABLED=true
# Machine credential shared by aiops/worker and the Compose execution Agent (32+ random characters).
EXECUTION_AGENT_TOKEN=
# Default: scenarios run only when explicitly triggered from the console.
# Set random only for an intentional continuous synthetic failure demo.
LOG_GENERATOR_MODE=manual
